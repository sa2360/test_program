{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physlab.local/schemas/vision.result.v1.schema.json",
  "title": "PhysLab vision result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "image_id", "experiment", "ts", "objects", "warning", "message", "processing_ms"],
  "properties": {
    "schema": {"const": "physlab.vision.v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "image_id": {"type": ["string", "null"], "maxLength": 96},
    "experiment": {"enum": ["rlc_series", "rlc_transient", "wheatstone_bridge"]},
    "ts": {"type": "integer", "minimum": 0},
    "objects": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "confidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 64},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "warning": {"type": ["string", "null"], "maxLength": 64},
    "message": {"type": "string", "maxLength": 300},
    "processing_ms": {"type": "integer", "minimum": 0}
  }
}
