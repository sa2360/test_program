{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physlab.local/schemas/camera.cmd.v1.schema.json",
  "title": "PhysLab camera command V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "action", "resolution", "jpeg_quality", "timeout_ms"],
  "properties": {
    "schema": {"const": "physlab.camera.cmd.v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "ts": {"type": "integer", "minimum": 0},
    "action": {"const": "capture"},
    "resolution": {"enum": ["QVGA", "VGA", "SVGA"]},
    "jpeg_quality": {"type": "integer", "minimum": 5, "maximum": 30},
    "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 30000}
  }
}
