{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A/B joint vision result V1 (Day08 format)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "image_id", "device_id", "result", "scene", "objects", "warnings", "suggestion"],
  "properties": {
    "schema": {"const": "physlab.vision.result.v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$"},
    "image_id": {"type": ["string", "null"], "maxLength": 96},
    "device_id": {"const": "camera01"},
    "result": {"enum": ["ok", "warning", "danger", "unknown"]},
    "scene": {"enum": ["rlc_series", "rlc_transient", "wheatstone_bridge"]},
    "objects": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "confidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 64},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "warnings": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["level", "code", "message"],
        "properties": {
          "level": {"enum": ["info", "warning", "danger"]},
          "code": {"type": "string", "minLength": 1, "maxLength": 64},
          "message": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "suggestion": {"type": "string", "minLength": 1, "maxLength": 300},
    "ts": {"type": "integer", "minimum": 0},
    "processing_ms": {"type": "integer", "minimum": 0},
    "source": {"enum": ["unconfigured", "manual", "model"]}
  }
}
